@baseUrl = http://localhost:4000

### Create event
# @name createEvent
POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": "Концерт",
  "description": "Великий концерт"
}

### List events
GET {{baseUrl}}/events

### Get event by id
GET {{baseUrl}}/events/{{createEvent.response.body.id}}

### Publish event
PATCH {{baseUrl}}/events/{{createEvent.response.body.id}}
Content-Type: application/json

{
  "status": "PUBLISHED"
}

### Delete event
DELETE {{baseUrl}}/events/{{createEvent.response.body.id}}

### Validation: wrong type and extra field
POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": 123,
  "id": "hack"
}

### Validation: blank title
POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": "   "
}

### Validation: wrong status
PATCH {{baseUrl}}/events/{{createEvent.response.body.id}}
Content-Type: application/json

{
  "status": "WRONG"
}

### Validation: invalid id
GET {{baseUrl}}/events/abc

### Validation: invalid id and status together
PATCH {{baseUrl}}/events/abc
Content-Type: application/json

{
  "status": "WRONG"
}

### Not found: valid UUID that doesn't exist
GET {{baseUrl}}/events/00000000-0000-4000-8000-000000000000